{
  "manifest_version": 3,
  "name": "HubAI Real Session Collector",
  "version": "1.0.0",
  "description": "Coletor oficial de sessão em tempo real do HubAI para plataformas de IA no Chrome",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.meta.ai/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.meta.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "HubAI Collector",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["bridge-config.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
